# Build output and packaged artifacts.
#
# These are deliberately not tracked: they are compiled binaries derived from a
# specific Wow.exe build, and the packaged zip is what gets served to players.
out/
dist/

# MSVC leftovers
*.obj
*.exp
*.lib
*.pdb
*.ilk
*.dll
*.exe

# Runtime logs written next to the client
AnimSpeedFix*.log
AnimTrace*.csv

# Python bytecode
__pycache__/
*.pyc

# Fonts copied out of the client for rendering previews. FRIZQT__.TTF is the
# licensed Friz Quadrata that ships with WoW; this repo is public.
*.ttf
*.TTF
